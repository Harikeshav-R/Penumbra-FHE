# ---- Rust ----
target/
**/target/
**/*.rs.bk
# Cargo.lock IS committed: the runtime is the deployable app (publish = false), so we want
# reproducible builds. uv.lock (Python) is committed for the same reason.

# ---- Python ----
__pycache__/
*.py[cod]
*.so
*.pyd
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
site/

# Virtual envs / uv
.venv/
venv/
.env

# ---- Penumbra artifacts ----
# NOTE: gitignore does not support inline comments — a trailing `# ...` becomes part of the
# pattern, so these must stand on their own lines to actually match.
*.fhe
# serialized IR / exported models
*.onnx
# exported model artifacts (examples regenerate these) — EXCEPT the small committed ONNX
# fixtures the loader's framework-proof and regression tests reload in CI (tests/test_onnx_fixture.py,
# tests/test_sklearn_fixture.py, tests/test_bn_cnn_fixture.py, tests/test_branch_fixture.py).
!examples/mnist/digit_cnn.onnx
!examples/mnist/digit_linear_sklearn.onnx
!examples/mnist/digit_tanh_mlp.onnx
!examples/mnist/digit_bn_cnn.onnx
!examples/mnist/digit_branch_mlp.onnx
!examples/mnist/digit_gap_cnn.onnx
!examples/faces/face_cnn.onnx
*.key
# crypto key material — never commit
*.ckpt
# downloaded datasets (MNIST, faces, ...)
data/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store

# ---- Agent / session scaffolding (local only, never tracked) ----
.claude/
.omp/
# local code-review notes — not project source
CODE_REVIEW_*.md
